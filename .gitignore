# Environment & Secrets
# Ignore the .env file containing secrets
.env

# Do not ignore the example file
!.env.example

# 2. Database files
*.db
*.sqlite3

# 3. Python cache & build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.coverage
.coverage.*

# 4. Virtual environments
venv/
.venv/

# 5. Logs & OS files
logs/
*.log
.DS_Store

# 6. IDE/editor config
.vscode/
.idea/
*.swp

# 7. Custom/project-specific
.windsurfrules
.windsurf
Info.md

# 8. Ignore test/migration artifacts (if any appear in future)
*.bak
*.tmp

# 9. Ignore resources/private data (optional, if you add user data)
# resources/**/private*

# 10. Alembic
# The alembic/versions directory contains crucial migration scripts and MUST be tracked.
# Other generated files like caches are already covered by __pycache__/.
